{
  "name": "org-zhixing",
  "version": "0.1.0",
  "private": true,
  "description": "A browser demo for viewing Org blog, records, and agenda data through orgize WASM.",
  "workspaces": [
    "packages/*",
    "themes/*"
  ],
  "type": "module",
  "exports": {
    "./library": "./src/library/index.ts",
    "./poo-flow": "./src/poo-flow/index.ts",
    "./poo-flow/react": "./src/react/PooFlowGraph.tsx"
  },
  "scripts": {
    "dev": "npm run generate:theme-assets && npm run generate:static && rsbuild dev",
    "generate:theme-assets": "node scripts/build-elegant-theme.mjs && oxfmt src/styles/theme.css",
    "theme:check": "node packages/theme-tooling/src/theme-check.mjs",
    "theme:create": "node packages/theme-tooling/src/theme-create.mjs",
    "theme:list": "node packages/theme-tooling/src/theme-list.mjs",
    "theme:preview": "node packages/theme-tooling/src/theme-preview.mjs",
    "pages:build": "node --import tsx packages/theme-tooling/src/pages-build.mjs",
    "pages:themes": "node packages/theme-tooling/src/pages-theme-gallery.mjs",
    "pages:route-shells": "node --import tsx packages/theme-tooling/src/pages-route-shells.mjs",
    "generate:static": "node --import tsx scripts/generate-static-site.mjs",
    "build": "npm run generate:theme-assets && npm run generate:static && tsc -b && rsbuild build && node --import tsx scripts/write-spa-fallback.mjs && node packages/theme-tooling/src/normalize-spa-shells.mjs",
    "test": "vitest run tests --exclude tests/poo-flow-scale-performance.test.ts --exclude tests/typst-performance-regression.test.ts",
    "test:poo-flow-performance": "vitest run tests/poo-flow-scale-performance.test.ts --no-file-parallelism --maxWorkers=1",
    "verify:core": "npm run format:check && npm run lint && npm run generate:theme-assets && npm run typecheck && npm run harness && npm test && npm run scenario:typst:cache && npm run test:poo-flow-performance && npm run build && npm run scenario:check",
    "verify:docs": "npm run test:docs && npm run test:contracts && npm run test:typst",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc -b --pretty false",
    "test:docs": "node --import tsx scripts/check-org-docs.mjs",
    "test:contracts": "node --import tsx scripts/check-org-contracts.mjs",
    "test:typst": "node --import tsx scripts/check-org-typst.mjs",
    "harness": "typescript-project-harness .",
    "harness:json": "typescript-project-harness --json .",
    "harness:agent-snapshot": "typescript-project-harness --agent-snapshot .",
    "perf": "npm run perf:wasm",
    "perf:wasm": "node scripts/bench-orgize-wasm.mjs",
    "perf:ui": "npm run build && node scripts/bench-org-zhixing-ui.mjs",
    "perf:all": "npm run perf:wasm -- --source=blog/travel.org && npm run perf:ui",
    "scenario:check": "node packages/scenario-benchmark/src/runner.mjs check",
    "scenario:update-baseline": "npm run build && node packages/scenario-benchmark/src/runner.mjs update-baseline",
    "scenario:browser": "env ORG_ZHIXING_CONTENT_DIR=blog npm run build && node --import tsx packages/scenario-benchmark/src/prepare-browser.mjs && env -u FORCE_COLOR -u NO_COLOR playwright test --config benchmarks/playwright.config.ts",
    "scenario:documents": "env -u FORCE_COLOR -u NO_COLOR playwright test --config benchmarks/documents.playwright.config.ts",
    "scenario:theme-federation": "npm run generate:theme-assets && node packages/scenario-benchmark/src/run-theme-federation.mjs",
    "scenario:lighthouse": "node packages/scenario-benchmark/src/prepare-lighthouse.mjs && lhci collect --config benchmarks/lighthouserc.cjs && lhci assert --config benchmarks/lighthouserc.cjs && lhci upload --config benchmarks/lighthouserc.cjs",
    "preview": "npm run generate:theme-assets && npm run generate:static && rsbuild preview",
    "scenario:typst": "npm run scenario:typst:cache && npm run scenario:typst:browser",
    "scenario:typst:cache": "vitest run tests/typst-performance-regression.test.ts tests/typst-render-coordinator.test.ts tests/org-static-typst-rendering.test.ts tests/org-typst-rendering.test.ts --no-file-parallelism --maxWorkers=1",
    "scenario:typst:browser": "env -u NO_COLOR playwright test --config benchmarks/typst.playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@module-federation/enhanced": "^2.8.2",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@poo-flow/runtime-wasm": "file:vendor/poo-flow-runtime-wasm-0.1.0.tgz",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@sigma/node-border": "^3.0.0",
    "@tanstack/query-core": "^5.102.1",
    "@tanstack/react-query": "^5.102.1",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/virtual-core": "^3.17.8",
    "@xyflow/react": "^12.11.3",
    "@zag-js/floating-panel": "^1.43.3",
    "@zag-js/vanilla": "^1.43.3",
    "culori": "^4.0.2",
    "elkjs": "^0.12.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "gsap": "^3.15.0",
    "katex": "^0.18.4",
    "masonry-layout": "^4.2.2",
    "mermaid": "^11.17.0",
    "minisearch": "^7.2.0",
    "orgize": "git+https://github.com/tao3k/orgize-wasm.git#52a29d6ca5f938f92746bf831fb5be7cbab727f9",
    "photoswipe": "^5.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "sigma": "^3.0.3",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.2.0",
    "@lhci/cli": "^0.15.1",
    "@module-federation/rsbuild-plugin": "^2.8.2",
    "@org-zhixing/theme-contract": "file:packages/theme-contract",
    "@playwright/test": "^1.62.1",
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-react": "^2.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/katex": "^0.16.8",
    "@types/masonry-layout": "^4.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "effect": "^3.22.1",
    "happy-dom": "^20.11.6",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "serve": "^14.2.6",
    "style-dictionary": "^5.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-lang-project-harness": "git+https://github.com/tao3k/typescript-lang-project-harness.git#04524b55706e77080e30795b9b7cfe014d24cfce",
    "unplugin": "^3.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "inquirer": "^9.3.8",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  }
}
